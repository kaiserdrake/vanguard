# Copy to .env and fill in. docker-compose reads .env automatically.
# Every value here has a working default except NTFY_URL and NTFY_TOPIC, so
# the shortest path to a running stack is: set those two, then `docker compose
# up -d`.

# Config and state for frigate, mosquitto, ntfy-bridge and scheduler. The
# `init` service seeds this directory from defaults/ on the first start, so
# there is nothing to stage by hand — and never anything to copy again, since
# it only writes files that aren't already there.
#
# Relative paths resolve against this repo (and are gitignored, so `git pull`
# stays clean). Point it somewhere outside the checkout — /srv/vanguard, say —
# if you'd rather the stack's state not live next to its source; docker
# creates the directory on first start either way.
APPDATA=./data

# Where recorded clips/snapshots are stored on the host. This is the one that
# grows without bound — put it on the big disk, not the system SSD. See the
# retention comments in defaults/frigate/config.yml for what it costs per
# camera per day.
MEDIA_PATH=./media

# Password Frigate expects on RTSP restream URLs it re-serves. Only used if
# your config references ${FRIGATE_RTSP_PASSWORD}; change it before pointing
# the stack at real cameras.
RTSP_PASSWORD=changeme

# ntfy server that receives the pushes. Deployed separately from this stack —
# nothing here starts an ntfy server, ntfy-bridge is only a client.
# Both are REQUIRED and have no defaults: on a public ntfy server anyone who
# knows the topic name can read the feed, so it is a secret, not a setting.
# Never commit a real topic — keep it here in .env, which is gitignored.
# Generate an unguessable one with:
#   head -c 12 /dev/urandom | base64 | tr -dc 'A-Za-z0-9'
NTFY_URL=https://ntfy.example.com
NTFY_TOPIC=replace-with-a-random-topic

# Required. Configure the server to refuse anonymous publishing, then generate
# a write-only token for this bridge on the ntfy host:
#   ntfy access <user> <your-topic> write-only
#   ntfy token add <user>
# Restrict read access too, so the topic name alone is not enough to subscribe.
NTFY_AUTH_TOKEN=

# Where a notification tap opens the recording. Two shapes, depending on
# whether Frigate is reachable from outside your network:
#
#   LAN only     https://192.168.1.50:8090
#                Frigate's authenticated port on your host. Keep the port in
#                step with the left side of the frigate `ports:` mapping in
#                docker-compose.yml. https:// because Frigate serves it with a
#                self-signed cert — expect a one-time warning per device, and
#                note the link only resolves while you're on the local network.
#
#   Public       https://frigate.example.com
#                A reverse-proxy hostname, no port. Notification taps then work
#                from anywhere, still behind Frigate's own login. Read "Public
#                access" in the README before switching to this — it exposes
#                every camera and recording to whoever gets past one password.
#
# Your real hostname belongs here in .env, not in this committed example.
FRIGATE_UI_URL=https://192.168.1.50:8090

# Comma-separated object labels that trigger a push notification. This is the
# default for every camera — cameras-meta.yml can widen or narrow it per camera
# (see "Per-camera notifications" in the README).
NOTIFY_LABELS=person,car,dog,cat

# Timezone for the scheduler's time-of-day windows, e.g. Asia/Tokyo
TZ=UTC
