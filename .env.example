# Copy to .env and fill in. docker-compose reads .env automatically.

# Where recorded clips/snapshots are stored on the host.
# On Unraid point this at a share, e.g. /mnt/user/frigate
MEDIA_PATH=./media

# Frigate's own state: event database, users, model cache. Small but must
# persist — losing it means losing the index of every recording.
# On Unraid: /mnt/user/appdata/frigate
CONFIG_PATH=./frigate-data

# Password Frigate expects on RTSP restream URLs it re-serves
RTSP_PASSWORD=changeme

# ntfy server that receives the pushes. Deployed separately from this stack —
# nothing here starts an ntfy server, ntfy-bridge is only a client.
# Both are REQUIRED and have no defaults: on a public ntfy server anyone who
# knows the topic name can read the feed, so it is a secret, not a setting.
# Never commit a real topic — keep it here in .env, which is gitignored.
# Generate an unguessable one with:
#   head -c 12 /dev/urandom | base64 | tr -dc 'A-Za-z0-9'
NTFY_URL=https://ntfy.example.com
NTFY_TOPIC=replace-with-a-random-topic

# Required. Configure the server to refuse anonymous publishing, then generate
# a write-only token for this bridge on the ntfy host:
#   ntfy access <user> <your-topic> write-only
#   ntfy token add <user>
# Restrict read access too, so the topic name alone is not enough to subscribe.
NTFY_AUTH_TOKEN=

# Where a notification tap opens the recording. Frigate's authenticated port
# (8971) on your LAN — change the IP to your host. Frigate is NOT exposed to
# the internet, so this link only resolves while you're on the local network.
# https:// because 8971 serves TLS with a self-signed cert (expect a one-time
# certificate warning per device).
FRIGATE_UI_URL=https://192.168.1.50:8971

# Comma-separated object labels that trigger a push notification
NOTIFY_LABELS=person,car,dog,cat

# Timezone for the scheduler's time-of-day windows, e.g. Asia/Tokyo
TZ=UTC

# Unraid only. Absolute path ON THE UNRAID HOST to the Docker tab icon —
# Unraid's webgui reads this file directly, so it can't be a path inside a
# container or a relative one. Copy unraid/vanguard.png there first:
#   mkdir -p /mnt/user/appdata/vanguard
#   cp unraid/vanguard.png /mnt/user/appdata/vanguard/
# Ignored on non-Unraid hosts — the label is just unused metadata there.
UNRAID_ICON=/mnt/user/appdata/vanguard/vanguard.png
