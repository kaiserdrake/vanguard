.env
.env.local
.env.production

# Local tooling config — machine-specific, and can accumulate paths/tokens
.claude/

# Local build override. Deliberately untracked: if it were committed, every
# clone (production included) would silently build images from source instead
# of pulling the CI-tested ones. See "Building the images" in the README for
# the two lines to recreate it when developing.
docker-compose.override.yml

# Frigate recordings/snapshots when MEDIA_PATH is left at the default
media/

# Live config + state, seeded from defaults/ by the init service, when APPDATA
# is left at the default. Everything in here is the deployment's, not the
# repo's — frigate.db, mosquitto's persistence, the edited config.yml.
data/

# generated per-run by tests/run_test.sh
tests/schedule.yml

__pycache__/
*.py[cod]
*.log

# test-deploy profile: recordings and Frigate's own state (dev/ holds its
# tracked configs; these two are runtime only)
dev-media/
dev-config/
